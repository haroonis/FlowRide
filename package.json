{
  "name": "flowride",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ride sharing for local events",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "lint": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 --test-reporter=spec tests/*.test.mjs",
    "test:api": "node --test --test-reporter=spec tests/api.test.mjs",
    "release": "npm run build && node scripts/release.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.22.3",
    "lucide-react": "^1.70.0",
    "preact": "^10.29.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "5.8",
    "vite": "^8.3.6"
  }
}
