# Password for the organiser dashboard (/organisers). Leave unset to disable it.
ADMIN_TOKEN=change-me-to-a-long-random-string  # at least 16 characters: openssl rand -base64 24
# Encrypts phone numbers in the database. Generate with: openssl rand -base64 32
# Store it as a secret, separately from database backups. If unset, a key file is created next to the DB.
DATA_KEY=
# Contact for security researchers (/.well-known/security.txt). Defaults to PRIVACY_EMAIL.
SECURITY_EMAIL=security@your-domain.org
# Brute-force limits per IP (15-minute window).
ADMIN_MAX_FAILS=10
LINK_MAX_FAILS=30
# Shown in the privacy notice. Required for UK GDPR transparency.
CONTROLLER_NAME="Your organisation name"
PRIVACY_EMAIL=privacy@your-domain.org
# Days after an event before all personal data is erased automatically.
RETENTION_DAYS=7
PUBLIC_URL=https://flowride.your-domain.org
PORT=3000
DB_PATH=./flowride.db
# Set to 1 when running behind one reverse proxy (Caddy/nginx), so rate limiting sees real IPs.
TRUST_PROXY=1
# Set to 0 to stop demo events being created on an empty database.
SEED_DEMO=1
